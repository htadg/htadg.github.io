      </div>
    </div>

    <!-- Avatar -->
    <div class="flex-shrink-0">
      <div class="relative w-56 h-56 md:w-72 md:h-72">
        <div class="absolute inset-0 bg-gradient-to-br from-[#2580ff]/20 to-[#6aa6fb]/10 rounded-full blur-3xl"></div>
        <div class="relative w-full h-full rounded-full border-2 border-[#2580ff]/20 bg-gray-100 dark:bg-gray-900 overflow-hidden flex items-center justify-center">
          <img
            src="/img/HitenSharma.jpg"
            alt="Hiten Sharma"
            width="288"
            height="288"
            loading="eager"
            decoding="async"
            class="w-full h-full object-cover object-top"
          />
        </div>
      </div>
    </div>

  </div>
</section>

<script>
  const roles = ['Senior Software Engineer', 'Java + Spring Boot', 'Micro-services & APIs', 'FinTech & AdTech', 'GCP Certified'];
  let roleIndex = 0;
  const el = document.getElementById('role-display');

  function showRole(text: string) {
    if (!el) return;
    // Fade in new text immediately
    el.textContent = text;
    el.classList.remove('role-fade-out');
    el.classList.add('role-fade-in');
  }

  function cycleRole() {
    if (!el) return;
    // Fade out current text
    el.classList.remove('role-fade-in');
    el.classList.add('role-fade-out');

    // After fade-out completes, swap text and fade in
    setTimeout(() => {
      roleIndex = (roleIndex + 1) % roles.length;
      showRole(roles[roleIndex]);
    }, 350); // matches fadeOut duration
  }

  // Show first role immediately
  showRole(roles[roleIndex]);

  // Cycle every 2.5s
  setInterval(cycleRole, 2500);
</script>
