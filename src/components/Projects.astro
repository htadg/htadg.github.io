---
const projects = [
  {
    title: "DataExport",
    description: "A Spring Batch based tool to export database data on demand. Supports multiple data sources, native SQL queries, column filtering, and batch processing — built as a production-grade POC that directly shaped a real architecture roadmap.",
    tech: ["Java", "Spring Boot", "Spring Batch", "PostgreSQL", "Docker"],
    github: "https://github.com/htadg/DataExport",
    live: null,
    period: "Jan 2025",
  },
  {
    title: "TaskIt Backend",
    description: "A multi-tenant task manager POC demonstrating enterprise-grade security patterns: JWT authentication, role-based hierarchy & authorization, path-based access control, and namespace-based multi-tenancy — with a full architectural design including user board and role diagrams.",
    tech: ["Java", "Spring Boot", "Spring Security", "JWT", "Multi-tenancy"],
    github: "https://github.com/htadg/taskit-backend",
    live: null,
    period: "Oct 2024",
  },
  {
    title: "ABToast",
    description: "A modular Django A/B testing library for Python web applications. Allows developers to easily run split tests on their Django apps to optimise user experience with minimal setup.",
    tech: ["Python", "Django", "A/B Testing"],
    github: "https://github.com/htadg/ABToast",
    live: null,
    period: "May 2016 – Jun 2016",
  },
  {
    title: "MSIT.in",
    description: "The official website for Maharaja Surajmal Institute of Technology — built and maintained the institutional web presence serving students and faculty throughout my undergraduate years.",
    tech: ["Python", "Django", "HTML/CSS", "JavaScript"],
    github: null,
    live: null,
    period: "Jun 2017 – May 2019",
  },
];
---

<section id="projects" class="py-24 bg-white dark:bg-gray-900/50 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4 mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Projects</h2>
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-800"></div>
      <a
        href="https://github.com/htadg"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[#1668d4] hover:underline whitespace-nowrap"
      >
        View all on GitHub →
      </a>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <article class="group p-6 rounded-xl bg-gray-50 dark:bg-gray-800/40 border border-gray-100 dark:border-gray-800 hover:border-[#2580ff]/40 hover:shadow-lg hover:shadow-blue-500/5 transition-all duration-200 flex flex-col">

          <div class="flex items-start justify-between mb-3">
            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-[#1668d4] transition-colors">
              {project.title}
            </h3>
            <div class="flex gap-3 ml-4 flex-shrink-0">
              {project.github && (
                <a href={project.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub repo"
                   class="text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                  </svg>
                </a>
              )}
              {project.live && (
                <a href={project.live} target="_blank" rel="noopener noreferrer" aria-label="Live site"
                   class="text-gray-400 hover:text-[#1668d4] transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}
            </div>
          </div>

          <p class="text-xs font-mono text-gray-500 dark:text-gray-400 mb-3">{project.period}</p>

          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed flex-1 mb-4">
            {project.description}
          </p>

          <div class="flex flex-wrap gap-2">
            {project.tech.map((t) => (
              <span class="px-2 py-0.5 text-xs rounded font-mono bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-300 border border-blue-100 dark:border-blue-900">
                {t}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
