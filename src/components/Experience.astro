---
const experience = [
  {
    company: "Mediaocean",
    role: "Senior Software Engineer – Development",
    period: "Feb 2026 – Present",
    location: "India · Remote",
    description: [
      "Built bulk import processing on a Java ExecutorService thread pool, letting advertisers create up to 100 campaigns and 10,000 media lines in a single operation — collapsing setup time for large accounts.",
      "Modernised a legacy core component in the Prisma Direct Integration pipeline serving Disney, improving the reliability and maintainability of a high-stakes client integration.",
      "Working across the Prisma advertising platform on high-volume campaign and media-line data flows.",
      "Full delivery accountability on high-visibility features: client demos, requirement analysis, estimation, development, and product Q&As.",
    ],
    tech: ["Java 17", "Spring Boot", "Concurrency", "ExecutorService"],
    current: true,
  },
  {
    company: "QBurst",
    role: "Senior Engineer",
    period: "Dec 2024 – Feb 2026",
    location: "Noida, Uttar Pradesh · Hybrid",
    description: [
      "Built a Spring Batch service with a multi-database connection pool for high-volume extraction — the throughput results directly shaped the production architecture roadmap.",
      "Authored end-to-end HLD & LLD for a travel booking recommendation SaaS platform, translating client requirements into a scalable, cloud-ready technical blueprint.",
      "Led an internal tech session on Spring Security, covering authentication and authorisation flows and project bootstrapping, to upskill the engineering team.",
    ],
    tech: ["Java", "Spring Boot", "Spring Batch", "Spring Security", "Micro-services", "HLD/LLD"],
    current: false,
  },
  {
    company: "Infosys",
    role: "Senior Associate Consultant",
    period: "Jan 2024 – Dec 2024",
    location: "Remote",
    description: [
      "Architected Java micro-services backing an analytics dashboard built from the ground up for a Fortune 500 payment card provider.",
      "Designed a Single-SPA micro-frontend, decoupling the UI into independently deployable modules and significantly reducing release friction.",
      "Built a Robot Framework test suite covering critical user flows, reducing manual QA effort and strengthening regression confidence across releases.",
      "Delivered ARIA/WCAG-compliant UI components meeting enterprise accessibility standards.",
      "Conducted technical interviews, contributing directly to engineering hiring decisions.",
    ],
    tech: ["Java", "Micro-services", "REST APIs", "Single-SPA", "React", "Robot Framework"],
    current: false,
  },
  {
    company: "Infosys",
    role: "Technology Analyst",
    period: "Jul 2022 – Dec 2023",
    location: "Bengaluru, Karnataka",
    description: [
      "Core contributor to a FinTech analytics and reporting platform for an asset management client.",
      "Designed and maintained RESTful APIs serving as the integration backbone between internal systems, standardising data contracts and reducing coupling.",
      "Cut Mutual Fund report generation from 12 min → under 8 min (~40% faster) by optimising the SQL pipeline feeding the analytics layer.",
      "Supported the full annual after-tax processing cycle, optimising queries to ensure accurate, on-time report delivery to clients.",
      "Mentored junior developers through code reviews and knowledge-transfer sessions, raising overall code quality and ensuring continuity across handovers.",
    ],
    tech: ["Java", "REST APIs", "SQL Performance", "Sybase IQ", "QlikView"],
    current: false,
  },
  {
    company: "Infosys",
    role: "Senior System Engineer",
    period: "Oct 2021 – Jul 2022",
    location: "Bengaluru, Karnataka",
    description: [
      "Built core trading and reporting workflows in Java Spring over Sybase ASE for a global investment banking client — systems used by hundreds of users daily.",
      "Diagnosed and resolved a critical API bottleneck in the GP Valuations analytics pipeline, cutting report load time from ~60 min → 10–15 min (~85% reduction).",
      "Recovered ~1 hour of productivity per user per day by independently identifying a review workflow bottleneck and designing a targeted fix.",
    ],
    tech: ["Java", "Spring", "REST APIs", "Sybase ASE", "ReactJS"],
    current: false,
  },
];

const education = [
  {
    institution: "Maharaja Surajmal Institute of Technology",
    degree: "B.Tech, Computer Science & Engineering",
    period: "2015 – 2019",
    detail: "Guru Gobind Singh Indraprastha University · CGPA 8.66 / 10.0",
  },
];
---

<section id="experience" class="py-24 bg-white dark:bg-gray-900/50 transition-colors duration-300">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4 mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Experience</h2>
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-800"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-12">

      <!-- Work Experience (wider column) -->
      <div class="md:col-span-2">
        <h3 class="text-sm font-semibold text-[#1668d4] uppercase tracking-widest font-mono mb-6">Work</h3>
        <div class="relative">
          <!-- vertical line -->
          <div class="absolute left-3 top-2 bottom-2 w-px bg-gray-200 dark:bg-gray-800"></div>

          <div class="space-y-6">
            {experience.map((job) => (
              <div class="relative pl-10">
                <!-- dot -->
                <div class={`absolute left-0 top-1.5 w-6 h-6 rounded-full border-2 flex items-center justify-center ${job.current ? 'bg-[#2580ff] border-[#2580ff]' : 'bg-white dark:bg-gray-950 border-gray-300 dark:border-gray-700'}`}>
                  {job.current && <div class="w-2 h-2 rounded-full bg-white"></div>}
                </div>

                <div class="p-5 rounded-xl bg-white dark:bg-gray-900/60 border border-gray-100 dark:border-gray-800">
                  <div class="flex items-start justify-between gap-2 mb-0.5">
                    <h4 class="font-semibold text-gray-900 dark:text-white">{job.company}</h4>
                    {job.current && (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-green-100 dark:bg-green-950/40 text-green-700 dark:text-green-400 font-medium whitespace-nowrap flex-shrink-0">
                        Current
                      </span>
                    )}
                  </div>
                  <p class="text-sm text-[#1668d4] font-medium mb-0.5">{job.role}</p>
                  <p class="text-xs text-gray-500 font-mono mb-3">{job.period} · {job.location}</p>
                  <ul class="space-y-1.5 mb-4">
                    {job.description.map((point) => (
                      <li class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed flex gap-2">
                        <span class="text-[#1668d4] mt-1 flex-shrink-0">›</span>
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="flex flex-wrap gap-1.5">
                    {job.tech.map((t) => (
                      <span class="px-2 py-0.5 text-xs rounded font-mono bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400">
                        {t}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Education + Languages (narrower column) -->
      <div class="space-y-8">
        <div>
          <h3 class="text-sm font-semibold text-[#1668d4] uppercase tracking-widest font-mono mb-6">Education</h3>
          <div class="space-y-4">
            {education.map((edu) => (
              <div class="p-5 rounded-xl bg-white dark:bg-gray-900/60 border border-gray-100 dark:border-gray-800">
                <h4 class="font-semibold text-gray-900 dark:text-white mb-1 text-sm">{edu.institution}</h4>
                <p class="text-sm text-[#1668d4] font-medium mb-1">{edu.degree}</p>
                <p class="text-xs text-gray-500 font-mono mb-2">{edu.period}</p>
                {edu.detail && (
                  <p class="text-sm text-gray-600 dark:text-gray-400">{edu.detail}</p>
                )}
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-[#1668d4] uppercase tracking-widest font-mono mb-4">Languages</h3>
          <div class="flex flex-wrap gap-2">
            {["English", "Hindi", "Punjabi"].map((lang) => (
              <span class="px-3 py-1 text-sm rounded-md bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium">
                {lang}
              </span>
            ))}
          </div>
        </div>

        <div>
          <h3 class="text-sm font-semibold text-[#1668d4] uppercase tracking-widest font-mono mb-4">Top Skills</h3>
          <div class="flex flex-wrap gap-2">
            {["Java", "Spring Boot", "Micro-services", "Spring Batch", "FinTech", "GCP"].map((s) => (
              <span class="px-3 py-1 text-sm rounded-md bg-blue-50 dark:bg-blue-950/30 border border-blue-100 dark:border-blue-900 text-blue-700 dark:text-blue-300 font-medium">
                {s}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
