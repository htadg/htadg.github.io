---
// Ordered deliberately: the Java/JVM depth a senior backend screen looks for
// comes first, supporting breadth last.
const skillGroups = [
  {
    category: "Java & Spring",
    skills: ["Java 17", "Spring Boot", "Spring Batch", "Spring Security", "Spring MVC", "Hibernate / JPA", "Reladomo", "Multithreading & Concurrency"],
    primary: true,
  },
  {
    category: "Architecture & Design",
    skills: ["Micro-services", "REST API Design", "HLD & LLD", "Apache Kafka", "Multi-tenancy", "RBAC", "BPMN Workflow", "Micro-frontends"],
    primary: true,
  },
  {
    category: "Data & Persistence",
    skills: ["PostgreSQL", "MySQL", "Sybase ASE", "Sybase IQ", "SQL Performance Tuning", "Connection Pooling", "MongoDB", "Redis"],
    primary: true,
  },
  {
    category: "Cloud & DevOps",
    skills: ["Google Cloud Platform", "Docker", "Kubernetes", "CI/CD", "Git", "Autosys"],
  },
  {
    category: "Testing & Quality",
    skills: ["Robot Framework", "Fitnesse", "Code Review", "QlikView", "ARIA / WCAG"],
  },
  {
    category: "Frontend & Other",
    skills: ["React", "TypeScript", "JavaScript", "Single-SPA", "Redux", "Python / Django", "Solidity / Ethereum"],
  },
];
---

<section id="skills" class="py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4 mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Skills</h2>
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-800"></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skillGroups.map((group) => (
        <div class={`p-6 rounded-xl transition-colors duration-200 hover:border-[#2580ff]/40 ${
          group.primary
            ? 'bg-blue-50/50 dark:bg-blue-950/20 border border-blue-100 dark:border-blue-900/50'
            : 'bg-white dark:bg-gray-900/60 border border-gray-100 dark:border-gray-800'
        }`}>
          <h3 class="text-sm font-semibold text-[#1668d4] uppercase tracking-widest mb-4 font-mono">
            {group.category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class={`px-3 py-1 text-sm rounded-md font-medium ${
                group.primary
                  ? 'bg-white dark:bg-gray-800 text-blue-800 dark:text-blue-200 border border-blue-100 dark:border-blue-900/60'
                  : 'bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300'
              }`}>
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
